# Shared Supabase project: "Digita Database" (ref peaotjteojnkrzkmtote)
# Web (apps/admin) — Vite
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mobile (apps/pos) — Expo
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side admin operations only. NEVER expose to a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Throwaway development login, prefilled on the sign-in form.
# Gated on import.meta.env.DEV, so Vite strips it from production builds.
# Delete these — and the account — before real data arrives.
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=
