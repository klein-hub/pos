{
  "name": "digita-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @digita/admin dev",
    "dev:pos": "pnpm --filter @digita/pos dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev:hub": "pnpm --filter @digita/hub dev",
    "dev:all": "pnpm --parallel --filter @digita/hub --filter @digita/admin --filter @digita/payroll --filter @digita/pos --filter @digita/web dev",
    "dev:payroll": "pnpm --filter @digita/payroll dev",
    "dev:web": "pnpm --filter @digita/web dev"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^5.5.3"
  }
}
