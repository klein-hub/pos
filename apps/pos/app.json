{
  "expo": {
    "name": "Digita POS",
    "slug": "digita-pos",
    "scheme": "digitapos",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6f4f1",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": ["expo-router"]
  }
}
